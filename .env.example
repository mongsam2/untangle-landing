# 실제 값은 .env.local 에 넣으세요 (.env* 는 .gitignore 처리되어 커밋되지 않습니다).

# Untangle AI 서버. 비워두면 로컬 개발 주소 http://127.0.0.1:8000 을 사용합니다.
# 브라우저에 공개하지 않는 서버 전용 값입니다.
UNTANGLE_AI_BASE_URL=

# AI Co-Planner (/api/split, /api/braindump) — 둘 중 하나만 있어도 동작합니다.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# 선택: claude | gpt — 사용할 공급자를 고정합니다.
# 비워두면 키가 있는 쪽을 자동 사용합니다(둘 다 있으면 Claude 우선).
LLM_PROVIDER=

# 체험 소감(만족도 피드백) → Google Sheets 저장 연동

# 시트에 연결된 Apps Script 웹 앱 배포 URL (형식: https://script.google.com/macros/s/.../exec)
SHEETS_WEBHOOK_URL=

# Apps Script 코드의 TOKEN 과 동일한 값 (아무도 못 맞출 긴 랜덤 문자열)
SHEETS_WEBHOOK_TOKEN=

# 사용자 행동 로그(PostHog) — 비워두면 분석이 조용히 꺼진 채로 앱은 그대로 동작합니다.
# 프로젝트/키 발급 절차는 POSTHOG_SETUP.md 참고. NEXT_PUBLIC_ 접두사라 브라우저에 노출됩니다
# (PostHog 프로젝트 API 키는 공개용 publishable 키라 노출이 정상입니다).
NEXT_PUBLIC_POSTHOG_KEY=
# 미국 클라우드 호스트. 비워두면 https://us.i.posthog.com 로 기본 설정됩니다.
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
